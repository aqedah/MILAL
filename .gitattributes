# Default
* text=auto

# Cross-platform source/docs: keep LF
*.py   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf

# Windows PowerShell
*.ps1  text eol=crlf

# Binary files
*.zip  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary

# MR1 byte-reproduction fixtures retain their intentional UTF-8 BOM / CRLF.
tests/fixtures/mr1/*.csv text eol=crlf

# Preserve the exact researcher-supplied ANA.0.3 request bytes and SHA256.
